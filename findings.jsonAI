    "proposed_patch": {
      "explanation": "Privileged admin and manager seed accounts now get unique, randomly generated passwords (overridable via SEED_ADMIN_PASSWORD/SEED_MANAGER_PASSWORD env vars) instead of sharing the same hardcoded, predictable dev password used for regular customers; the generated credentials are logged once so a developer can retrieve them. This assumes `crypto` can be imported/used in this file (Node's built-in crypto module).",
      "patchable": true,
      "diff": "--- a/server/src/seed.ts\n+++ b/server/src/seed.ts\n@@ -1,7 +1,10 @@\n   // הכנסת לקוחות (עם תאריכי יצירה מגוונים)\n   console.log(\"👥 מכניס משתמשי backoffice + 20 לקוחות...\");\n \n   // ⚠️ Customer.insertMany לא מפעיל pre('save'), לכן נצפין סיסמאות מראש בעצמנו.\n-  // סיסמת dev אחידה לכל המשתמשים: Admin1234 (תואם ל-MOCK_USER הישן בלקוח)\n-  const DEV_PASSWORD = \"***MASKED***\";\n+  // סיסמת dev ללקוחות הדמו-אקראיים; לחשבונות backoffice משתמשים סיסמאות ייעודיות שאינן צפויות\n+  const DEV_PASSWORD = \"***MASKED***\";\n+  const ADMIN_PASSWORD = process.env.SEED_ADMIN_PASSWORD || crypto.randomBytes(12).toString(\"base64url\");\n+  const MANAGER_PASSWORD = process.env.SEED_MANAGER_PASSWORD || crypto.randomBytes(12).toString(\"base64url\");\n+  const hashedAdminPassword = await bcrypt.hash(ADMIN_PASSWORD, 12);\n+  const hashedManagerPassword = await bcrypt.hash(MANAGER_PASSWORD, 12);\n+  if (!process.env.SEED_ADMIN_PASSWORD || !process.env.SEED_MANAGER_PASSWORD) {\n+    console.log(`   🔐 Generated admin password: ${ADMIN_PASSWORD}`);\n+    console.log(`   🔐 Generated manager password: ${MANAGER_PASSWORD}`);\n+  }\n   const hashedDevPassword = await bcrypt.hash(DEV_PASSWORD, 12);\n \n   // משתמשי backoffice ידועים מראש - לפיתוח ו-RBAC testing\n   const backofficeUsers: Array<{\n     name: string;\n     email: string;\n     password: string;\n     role: UserRole;\n   }> = [\n-    { name: \"Admin TechStore\", email: \"admin@techstore.com\", password: hashedDevPassword, role: \"admin\" },\n-    { name: \"Manager TechStore\", email: \"manager@techstore.com\", password: hashedDevPassword, role: \"manager\" },\n+    { name: \"Admin TechStore\", email: \"admin@techstore.com\", password: hashedAdminPassword, role: \"admin\" },\n+    { name: \"Manager TechStore\", email: \"manager@techstore.com\", password: hashedManagerPassword, role: \"manager\" },\n   ];\n"
    }
